<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <!-- Fondo blanco: el QR necesita máximo contraste para que el escáner
         de otro dispositivo lo lea a la primera. -->
    <androidx.cardview.widget.CardView
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="center_horizontal"
        android:backgroundTint="@android:color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/ivVaultQr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/pixie_vault_qr_description_arg"
            android:padding="10dp"
            tools:src="@drawable/ic_key" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/pixie_vault_dialog_hint"
        android:textAppearance="@style/TextAppearance.AmWF.BodySmall" />

    <!-- Baldosa de la contraseña: el naranja de la app resalta la clave sobre
         el cristal del diálogo. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_vault_password"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pixie_vault_password_label"
            android:textAppearance="@style/TextAppearance.AmWF.Overline"
            android:textColor="@color/managed" />

        <TextView
            android:id="@+id/tvVaultPsk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@color/managed"
            android:textIsSelectable="true"
            android:textStyle="bold"
            tools:text="clave-de-la-red" />
    </LinearLayout>

    <!-- Acciones en baldosas: cada botón lleva su propio contenedor; nada de
         texto suelto flotando sobre el panel. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVaultCopy"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/pixie_vault_copy_password"
            android:textSize="13sp"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_copy"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVaultForget"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/pixie_vault_forget"
            android:textColor="@color/managed"
            android:textSize="13sp"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_delete_forever"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="16dp"
            app:iconTint="@color/managed"
            app:strokeColor="@color/vault_psk_stroke" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVaultDismiss"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/pixie_vault_dismiss"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:textSize="13sp"
            app:cornerRadius="14dp"
            app:strokeColor="@color/md_theme_outline" />
    </LinearLayout>
</LinearLayout>
