<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp">

    <!-- Fondo blanco: el QR necesita máximo contraste para que el escáner
         de otro dispositivo lo lea a la primera. -->
    <androidx.cardview.widget.CardView
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="center_horizontal"
        android:backgroundTint="@android:color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/ivVaultQr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/pixie_vault_qr_description_arg"
            android:padding="10dp"
            tools:src="@drawable/ic_key" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/pixie_vault_dialog_hint"
        android:textAppearance="@style/TextAppearance.AmWF.BodySmall" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/pixie_vault_password_label"
        android:textAppearance="@style/TextAppearance.AmWF.Overline" />

    <TextView
        android:id="@+id/tvVaultPsk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        android:textColor="@color/md_theme_onSurface"
        android:textIsSelectable="true"
        tools:text="clave-de-la-red" />
</LinearLayout>
